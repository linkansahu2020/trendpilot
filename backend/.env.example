Instagram__AppId=dummy-app-id
Instagram__AppSecret=dummy-app-secret

# Free key from https://aistudio.google.com/apikey
Gemini__ApiKey=dummy-gemini-api-key
Gemini__Model=gemini-3.8-flash
Whisper__Model=small
Clips__WorkDir=data/clips
Clips__MaxDurationMinutes=60
Clips__MaxUploadMb=2048
Clips__AllowUrls=true
# Folder holding an ffmpeg and ffprobe built with libass, e.g. Homebrew ffmpeg-full.
Clips__FfmpegDir=/opt/homebrew/opt/ffmpeg-full/bin
# Standalone yt-dlp for YouTube links (brew install yt-dlp). Found on PATH or in /opt/homebrew/bin when unset.
# Clips__YtDlpPath=/opt/homebrew/bin/yt-dlp
